# Copy to apps/api/.env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed web origins, e.g. http://localhost:8081
CORS_ORIGINS=

# Added in later weeks:
# DATABASE_URL=            # W2: Supabase pooler (session mode) connection string
# OPENAI_API_KEY=          # W5: backend only
# OPENAI_MODEL=gpt-4.1-mini
# RATE_LIMIT_ASK_PER_DAY=
