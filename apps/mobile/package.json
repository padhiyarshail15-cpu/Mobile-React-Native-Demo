{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --active-arch-only",
    "ios": "react-native run-ios",
    "ios:dev": "react-native run-ios --scheme ReactNativeDemo-Dev --mode Debug",
    "ios:prod": "react-native run-ios --scheme ReactNativeDemo-Prod --mode Release",
    "dev": "react-native start --reset-cache",
    "open:android": "open -a 'Android Studio' android",
    "open:ios": "open ios/ReactNativeDemo.xcworkspace",
    "pods": "cd ios && (bundle check || bundle install) && bundle exec pod install",
    "pod:install": "cd ios && bundle exec pod install",
    "pod:install:ci": "cd ios && bundle exec pod install --deployment",
    "bundle:install": "bundle install",
    "build": "mkdir -p dist/ios && react-native bundle --platform ios --dev false --entry-file index.js --bundle-output dist/ios/main.jsbundle --assets-dest dist/ios",
    "clean": "rm -rf dist coverage .turbo ios/build ios/Pods android/build android/app/build android/.gradle && (watchman watch-del-all 2>/dev/null || true)",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "check-deps": "rnx-align-deps --requirements react-native@0.88.1"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.88.1",
    "@repo/ui": "workspace:*",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-config": "^1.7.2",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@repo/config-jest": "workspace:*",
    "@rnx-kit/align-deps": "^3.2.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.22.0",
    "jest": "^29.6.3",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
