{
  "name": "reactnativedemo-monorepo",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=mobile",
    "start": "yarn dev",
    "ios": "yarn workspace mobile ios",
    "ios:dev": "yarn workspace mobile ios:dev",
    "ios:prod": "yarn workspace mobile ios:prod",
    "android": "yarn workspace mobile android",
    "open:ios": "yarn workspace mobile open:ios",
    "open:android": "yarn workspace mobile open:android",
    "pods": "yarn workspace mobile pods",
    "pod:install": "yarn workspace mobile pod:install",
    "pod:install:ci": "yarn workspace mobile pod:install:ci",
    "bundle:install": "yarn workspace mobile bundle:install",
    "build": "turbo run build",
    "ci": "yarn format:check && turbo run lint typecheck test build --continue",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --continue",
    "test:ci": "turbo run test --continue -- --ci --coverage --maxWorkers=2 --no-watchman",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage --continue",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "clean:cache": "turbo run clean && rm -rf .turbo && (watchman watch-del-all 2>/dev/null || true) && yarn workspace mobile jest --clearCache",
    "prepare": "lefthook install"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^9.22.0",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "lefthook": "^1.13.6",
    "lint-staged": "^16.2.4",
    "prettier": "2.8.8",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
